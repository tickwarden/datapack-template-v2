{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "objD Watch",
      "type": "shell",
      "command": "dart run build_runner watch",
      "options": {
        "cwd": "${workspaceFolder}/my_datapack"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    }
  ]
}